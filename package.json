{
  "name": "CD-Audio-PLayer",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.hdsoundsystem.cdplayer",
    "productName": "CD Audio PLayer",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
